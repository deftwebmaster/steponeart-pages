---
import { settings } from '../lib/settings';
---
<footer class="site-footer container">
  <p class="domain">StepOneArt24.com</p>
  {
    settings.socialLinks.length > 0 && (
      <ul class="social" aria-label="Social links">
        {settings.socialLinks.map((s) => (
          <li>
            <a href={s.url} rel="noopener">{s.label}</a>
          </li>
        ))}
      </ul>
    )
  }
  <p class="credit">
    Website donated by <a href="https://manicwebmaster.com">ManicWebmaster</a>
  </p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-block: 1.4rem 2.5rem;
    border-top: 1px solid var(--line-strong);
    font-size: 1rem;
  }
  .credit {
    font-size: 0.8125rem;
    color: var(--text-soft);
  }
  .credit a {
    color: inherit;
  }
  .social {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
  }
  .social a {
    color: var(--text-muted);
  }
</style>
