---
/**
 * The framed logo "photograph" in the hero, built from the original logo
 * image plus CSS (wall, light, shelf, oak frame, mat) and a small inline
 * SVG vase. No screenshot or stock photo is used.
 */
import { Image } from 'astro:assets';
import logo from '../assets/brand/step-one-art-logo.png';

// Deterministic sprig of leaves for the vase: leaves are placed along each
// cubic Bézier stem, alternating sides and angled toward the tip.
type Pt = [number, number];
const stems: { p: [Pt, Pt, Pt, Pt]; leaves: number }[] = [
  { p: [[100, 198], [97, 150], [86, 112], [62, 66]], leaves: 7 },
  { p: [[101, 198], [104, 146], [114, 104], [138, 60]], leaves: 7 },
  { p: [[99, 198], [94, 172], [76, 146], [44, 128]], leaves: 5 },
  { p: [[102, 198], [110, 174], [128, 156], [158, 146]], leaves: 5 },
  { p: [[100, 198], [99, 150], [101, 84], [104, 26]], leaves: 8 },
];
const bez = (p: [Pt, Pt, Pt, Pt], t: number): Pt => {
  const u = 1 - t;
  return [0, 1].map(
    (k) => u * u * u * p[0][k] + 3 * u * u * t * p[1][k] + 3 * u * t * t * p[2][k] + t * t * t * p[3][k],
  ) as Pt;
};
const tangent = (p: [Pt, Pt, Pt, Pt], t: number) => {
  const u = 1 - t;
  const d = [0, 1].map(
    (k) => 3 * u * u * (p[1][k] - p[0][k]) + 6 * u * t * (p[2][k] - p[1][k]) + 3 * t * t * (p[3][k] - p[2][k]),
  );
  return (Math.atan2(d[1], d[0]) * 180) / Math.PI;
};
const LEAF = 'M0 0 C 5 -5.5 13 -5 19 0 C 13 5 5 5.5 0 0 Z';
const leaves = stems.flatMap((stem, si) => {
  const out = Array.from({ length: stem.leaves }, (_, i) => {
    const t = 0.32 + (0.64 * i) / (stem.leaves - 1);
    const [x, y] = bez(stem.p, t);
    const side = (i + si) % 2 ? 1 : -1;
    return { x, y, angle: tangent(stem.p, t) + side * 42, scale: 1.05 - t * 0.45, shade: (i + si) % 3 === 0 };
  });
  const [tx, ty] = stem.p[3];
  out.push({ x: tx, y: ty, angle: tangent(stem.p, 1), scale: 0.6, shade: false });
  return out;
});
// Pseudo-random speckles inside the vase body.
const hash = (n: number) => {
  const v = Math.sin(n * 127.1 + 311.7) * 43758.5453;
  return v - Math.floor(v);
};
const speckles = Array.from({ length: 90 }, (_, i) => ({
  x: 100 + (hash(i) * 2 - 1) * 36,
  y: 262 + (hash(i + 500) * 2 - 1) * 38,
  r: 0.6 + hash(i + 900) * 0.9,
})).filter((s) => ((s.x - 100) / 36) ** 2 + ((s.y - 262) / 38) ** 2 < 0.85);
---
<div class="scene" role="img" aria-label="The Step One Art logo — winged emblem reading “Step One Art: You are worth it, and you can do it”, with mountains and the name John Hyder — framed on a softly lit shelf beside a small vase of leaves.">
  <div class="scene__light" aria-hidden="true"></div>
  <div class="scene__shelf" aria-hidden="true"></div>
  <svg class="scene__vase" viewBox="0 0 200 310" aria-hidden="true" focusable="false">
    <g fill="none" stroke="#6b6a36" stroke-width="1.8" stroke-linecap="round">
      {stems.map(({ p }) => <path d={`M${p[0].join(' ')} C ${p[1].join(' ')} ${p[2].join(' ')} ${p[3].join(' ')}`} />)}
    </g>
    <g>
      {
        leaves.map((l) => (
          <path
            d={LEAF}
            fill={l.shade ? '#8c8c48' : '#6f7335'}
            transform={`translate(${l.x.toFixed(1)} ${l.y.toFixed(1)}) rotate(${l.angle.toFixed(0)}) scale(${l.scale.toFixed(2)})`}
          />
        ))
      }
    </g>
    <path d="M86 196 h28 c0 10 4 14 12 24 c14 18 18 34 16 52 c-2 20 -14 32 -42 34 c-28 -2 -40 -14 -42 -34 c-2 -18 2 -34 16 -52 c8 -10 12 -14 12 -24z" fill="#ece5d8" />
    <path d="M86 196 h28 c0 10 4 14 12 24 c14 18 18 34 16 52 c-2 20 -14 32 -42 34 c8 -10 14 -30 12 -54 c-2 -24 -12 -36 -18 -42 c-4 -4 -8 -8 -8 -14z" fill="#d9d0c0" opacity="0.7" />
    <ellipse cx="100" cy="196" rx="14" ry="3" fill="#cfc6b6" />
    <g fill="#8b8378" opacity="0.8">{speckles.map((s) => <circle cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={s.r.toFixed(2)} />)}</g>
  </svg>
  <div class="scene__frame">
    <div class="scene__mat">
      <Image
        src={logo}
        alt=""
        widths={[280, 420, 560, 840, 1200]}
        sizes="(min-width: 64rem) 300px, (min-width: 40rem) 36vw, 60vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="scene__logo"
      />
    </div>
  </div>
</div>

<style>
  .scene {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: #e2cdb2;
    background-image:
      radial-gradient(110% 85% at 20% 8%, rgba(250, 236, 214, 0.75) 0%, rgba(250, 236, 214, 0) 62%),
      radial-gradient(80% 70% at 100% 100%, rgba(150, 110, 70, 0.22) 0%, rgba(150, 110, 70, 0) 70%);
  }
  /* Soft window light falling across the wall */
  .scene__light {
    position: absolute;
    inset: -10%;
    background: linear-gradient(
      118deg,
      transparent 18%,
      rgba(255, 250, 238, 0.5) 24%,
      transparent 31%,
      transparent 40%,
      rgba(255, 250, 238, 0.38) 46%,
      transparent 54%
    );
    filter: blur(10px);
  }
  .scene__shelf {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 8.5%;
    background: linear-gradient(#d9b88f, #c49c6c 30%, #b68d5e);
    box-shadow: 0 -1px 0 rgba(255, 245, 225, 0.8);
  }
  .scene__vase {
    position: absolute;
    left: 3%;
    bottom: 5.5%;
    width: 25%;
    height: auto;
    filter: drop-shadow(10px 6px 8px rgba(90, 60, 30, 0.22));
  }
  .scene__frame {
    position: absolute;
    right: 11.5%;
    bottom: 7.5%;
    /* Sized from the height so the frame always fits inside the scene. */
    height: 86%;
    aspect-ratio: 0.92;
    padding: 2.4%;
    background: linear-gradient(135deg, #c99a62, #b07f48 55%, #a2733f);
    box-shadow:
      inset 0 0 0 1px rgba(80, 50, 20, 0.35),
      18px 18px 26px -10px rgba(70, 45, 20, 0.38),
      4px 4px 8px rgba(70, 45, 20, 0.15);
  }
  .scene__mat {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 3.5% 3%;
    background: #f6f2ea;
    box-shadow: inset 2px 2px 6px rgba(60, 40, 20, 0.22);
  }
  .scene__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  @media (max-width: 40rem) {
    .scene__frame {
      right: 6%;
    }
    .scene__vase {
      width: 23%;
      left: 2%;
    }
  }
</style>
