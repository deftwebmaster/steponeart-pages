---
/**
 * Enlarged image viewer for an artwork page, built on the native <dialog>
 * element (modal focus handling and Escape-to-close come from the browser).
 * Arrow keys move between photos. Without JavaScript, the main image and
 * thumbnails are plain links to the large image files.
 */
interface Props {
  title: string;
  images: { src: string; srcset: string; width: number; height: number; alt: string }[];
}
const { title, images } = Astro.props;
const multiple = images.length > 1;
---
<dialog class="viewer" aria-labelledby="viewer-title" data-viewer data-images={JSON.stringify(images)}>
  <div class="viewer__inner">
    <header class="viewer__bar">
      <h2 id="viewer-title" class="viewer__title">{title}</h2>
      <p class="viewer__count" aria-live="polite" data-viewer-count></p>
      <button class="viewer__btn viewer__close" type="button" data-viewer-close>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
        <span>Close</span>
      </button>
    </header>
    <figure class="viewer__figure">
      <img data-viewer-img alt="" loading="lazy" decoding="async" src={images[0]?.src} width={images[0]?.width} height={images[0]?.height} />
      <figcaption class="viewer__caption" data-viewer-caption></figcaption>
    </figure>
    {
      multiple && (
        <div class="viewer__nav">
          <button class="viewer__btn" type="button" data-viewer-prev>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7" /></svg>
            <span>Previous</span>
          </button>
          <button class="viewer__btn" type="button" data-viewer-next>
            <span>Next</span>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
      )
    }
  </div>
</dialog>

<script>
  type ViewerImage = { src: string; srcset: string; width: number; height: number; alt: string };

  const dialog = document.querySelector<HTMLDialogElement>('[data-viewer]');
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');

  if (dialog && gallery && typeof dialog.showModal === 'function') {
    const images: ViewerImage[] = JSON.parse(dialog.dataset.images ?? '[]');
    const img = dialog.querySelector<HTMLImageElement>('[data-viewer-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-viewer-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-viewer-count]')!;
    const mains = [...gallery.querySelectorAll<HTMLAnchorElement>('[data-main]')];
    const thumbs = [...gallery.querySelectorAll<HTMLAnchorElement>('[data-thumb]')];
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + images.length) % images.length;
      const image = images[index];
      img.src = image.src;
      img.srcset = image.srcset;
      img.sizes = '100vw';
      img.width = image.width;
      img.height = image.height;
      img.alt = image.alt;
      caption.textContent = image.alt;
      count.textContent = images.length > 1 ? `Image ${index + 1} of ${images.length}` : '';
    };

    /** Change the photo shown on the page (not the dialog). */
    const select = (i: number) => {
      mains.forEach((m, n) => (m.hidden = n !== i));
      thumbs.forEach((t, n) => (n === i ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
    };

    const open = (i: number, trigger: HTMLElement) => {
      opener = trigger;
      show(i);
      dialog.showModal();
      dialog.querySelector<HTMLButtonElement>('[data-viewer-close]')?.focus();
    };

    mains.forEach((link) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        open(Number(link.dataset.main), link);
      }),
    );
    thumbs.forEach((thumb) =>
      thumb.addEventListener('click', (e) => {
        e.preventDefault();
        select(Number(thumb.dataset.thumb));
      }),
    );

    dialog.querySelector('[data-viewer-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-viewer-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-viewer-next]')?.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('keydown', (e) => {
      if (images.length < 2) return;
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        show(index - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        show(index + 1);
      }
    });
    // Click on the backdrop (outside the content) closes.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      // Keep the page in step with the last photo viewed, then return focus.
      select(index);
      const target = mains[index] ?? opener;
      (target && !target.hidden ? target : opener)?.focus();
    });
  }
</script>

<style>
  .viewer {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #181c22;
    color: #f4f1ea;
  }
  .viewer::backdrop {
    background: rgba(24, 28, 34, 0.6);
  }
  .viewer__inner {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    height: 100%;
    padding: 0.75rem clamp(0.75rem, 3vw, 2rem) 1rem;
  }
  .viewer__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .viewer__title {
    font-size: 1.2rem;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .viewer__count {
    font-size: 0.9rem;
    color: #c9c4ba;
  }
  .viewer__figure {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    margin: 0.75rem 0;
    min-height: 0;
  }
  .viewer__figure img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    min-height: 0;
  }
  .viewer__caption {
    margin-top: 0.6rem;
    text-align: center;
    font-size: 0.9rem;
    color: #c9c4ba;
  }
  .viewer__nav {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }
  .viewer__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0.45rem 1rem;
    font: inherit;
    font-size: 0.95rem;
    color: #f4f1ea;
    background: transparent;
    border: 1px solid rgba(244, 241, 234, 0.4);
    border-radius: 3px;
    cursor: pointer;
  }
  .viewer__btn:hover {
    border-color: #f4f1ea;
  }
  .viewer__btn:focus-visible {
    outline: 2px solid #9cc4ea;
    outline-offset: 2px;
  }
  .viewer__btn svg {
    width: 1.2rem;
    height: 1.2rem;
  }
</style>
