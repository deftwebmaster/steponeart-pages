---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/nunito-sans/index.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DemoNotice from '../components/DemoNotice.astro';
// Supplied 1200×630 share card, used for every page except artwork pages
// (which use a photo of the artwork itself).
import ogDefault from '../assets/brand/og-share-card.jpg';
import { settings, SITE_URL } from '../lib/settings';

interface Props {
  /** Page-specific title; the site name is appended. Omit on the homepage. */
  title?: string;
  description?: string;
  /** Social sharing image (already processed URL or an imported image). */
  ogImage?: { src: string; width: number; height: number; alt: string };
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Set for pages that must never be indexed (e.g. 404). */
  noindex?: boolean;
  current?: 'artwork' | 'purpose' | 'donate';
}

const {
  title,
  description = settings.siteDescription,
  ogImage,
  ogType = 'website',
  structuredData,
  noindex = false,
  current,
} = Astro.props;

const fullTitle = title ? `${title} · ${settings.siteName}` : `${settings.siteName} · Art that helps sober living residents pay rent`;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const robots = settings.demoMode || noindex ? 'noindex, nofollow' : 'index, follow';

const fallbackOg = await getImage({ src: ogDefault, width: 1200, height: 630, format: 'jpg', quality: 88 });
const og = ogImage ?? { src: fallbackOg.src, width: 1200, height: 630, alt: 'Step One Art — Art that helps someone stay. Artwork sales help pay rent for residents of sober living. StepOneArt24.com. Beside the text, the winged Step One Art logo in a wooden frame.' };
const ogSrc = new URL(og.src, SITE_URL).href;
const jsonLd = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#faf7f1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:site_name" content={settings.siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? settings.siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogSrc} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? settings.siteName} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogSrc} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {settings.demoMode && settings.demoNotice && <DemoNotice text={settings.demoNotice} />}
    <Header current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
