---
import { Picture, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArtworkCard from '../../components/ArtworkCard.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import ImageViewer from '../../components/ImageViewer.astro';
import {
  artworkUrl,
  categoryValue,
  formatPrice,
  getArtworks,
  getRelatedArtworks,
  inquiryHref,
  mailto,
  sourceLabel,
  type Artwork,
} from '../../lib/artwork';
import { contactEmail, SITE_URL } from '../../lib/settings';

export async function getStaticPaths() {
  const artworks = await getArtworks();
  return artworks.map((artwork) => ({ params: { slug: artwork.id }, props: { artwork } }));
}

interface Props {
  artwork: Artwork;
}

const { artwork } = Astro.props;
const { data } = artwork;
const { Content } = await render(artwork);
const related = await getRelatedArtworks(artwork, 3);

const images = [{ image: data.image, alt: data.imageAlt }, ...data.gallery];

// Large versions for the viewer, capped so full-resolution phone photos are never shipped.
const large = await Promise.all(
  images.map(async ({ image, alt }) => {
    const widths = [960, 1600, 2200].filter((w) => w < image.width);
    widths.push(Math.min(image.width, 2400));
    const variants = await Promise.all(widths.map((w) => getImage({ src: image, width: w, format: 'webp' })));
    const best = variants[variants.length - 1];
    return {
      src: best.src,
      srcset: variants.map((v, i) => `${v.src} ${widths[i]}w`).join(', '),
      width: Number(best.attributes.width),
      height: Number(best.attributes.height),
      alt,
    };
  }),
);

const og = await getImage({ src: data.image, width: 1200, format: 'jpg', quality: 80 });
const ogImage = { src: og.src, width: Number(og.attributes.width), height: Number(og.attributes.height), alt: data.imageAlt };

const inquiry = inquiryHref(artwork);
const reservedAsk = mailto(
  `Question about: ${data.title}`,
  `Hello,\n\nI see "${data.title}" by ${data.artist} is reserved. Could you let me know if it becomes available?\n${artworkUrl(artwork)}\n\nThank you,`,
);
const status = data.availability.toLowerCase();
const price = formatPrice(data.price);
const description = `${data.title} by ${data.artist}. ${data.summary}`.slice(0, 300);

const schemaAvailability: Record<string, string | undefined> = {
  Available: 'https://schema.org/InStock',
  Sold: 'https://schema.org/SoldOut',
};
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'VisualArtwork',
    name: data.title,
    url: artworkUrl(artwork),
    image: images.map((_, i) => new URL(large[i].src, SITE_URL).href),
    description: data.summary,
    creator: { '@type': 'Person', name: data.artist },
    ...(data.medium ? { artMedium: data.medium } : {}),
    artform: data.category,
    ...(data.dimensions ? { size: data.dimensions } : {}),
    ...(schemaAvailability[data.availability] && data.price !== undefined
      ? {
          offers: {
            '@type': 'Offer',
            price: data.price,
            priceCurrency: 'USD',
            availability: schemaAvailability[data.availability],
            url: artworkUrl(artwork),
          },
        }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Artwork', item: `${SITE_URL}/artwork/` },
      { '@type': 'ListItem', position: 3, name: data.title, item: artworkUrl(artwork) },
    ],
  },
];
---
<Base title={`${data.title} by ${data.artist}`} description={description} ogImage={ogImage} ogType="article" current="artwork" structuredData={structuredData}>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/artwork/">Artwork</a></li>
        <li><span aria-current="page">{data.title}</span></li>
      </ol>
    </nav>

    <article class="artwork">
      <div class="artwork__media" data-gallery>
        <div class="artwork__stage">
          {
            images.map(({ image, alt }, i) => (
              <a
                class="artwork__main"
                href={large[i].src}
                data-viewer-open={i}
                data-main={i}
                hidden={i !== 0}
                aria-label={`View larger image ${images.length > 1 ? `${i + 1} of ${images.length}` : ''}: ${alt}`}
              >
                <Picture
                  src={image}
                  alt={alt}
                  widths={[480, 720, 960, 1280].filter((w) => w <= image.width)}
                  sizes="(min-width: 64rem) 640px, (min-width: 48rem) 56vw, 100vw"
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
                <span class="artwork__zoom" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5M11 8v6M8 11h6" /></svg>
                  View larger
                </span>
              </a>
            ))
          }
        </div>
        {
          images.length > 1 && (
            <ul class="thumbs" aria-label="More photos of this artwork">
              {images.map(({ image, alt }, i) => (
                <li>
                  <a href={large[i].src} class="thumb" data-thumb={i} aria-current={i === 0 ? 'true' : undefined} aria-label={`Photo ${i + 1} of ${images.length}: ${alt}`}>
                    <Picture src={image} alt="" widths={[120, 240]} sizes="120px" formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="artwork__info">
        <p class="eyebrow">{data.category} · {data.source === 'john' ? 'Original by John Hyder' : 'Donated artwork'}</p>
        <h1>{data.title}</h1>
        <p class="artwork__artist">by {data.artist}</p>

        <p class="artwork__price-row">
          <span class:list={['artwork__price', `artwork__price--${status}`, { 'artwork__price--request': data.price === undefined }]}>{price}</span>
          <span class={`badge badge--${status}`}>{data.availability}</span>
        </p>

        <div class="action">
          {
            data.availability === 'Available' &&
              (inquiry ? (
                <>
                  <a class="button" href={inquiry}>
                    Ask about buying this piece <ArrowIcon />
                  </a>
                  <p class="action__note">
                    Opens your email app with the artwork details filled in, addressed to <span class="nowrap">{contactEmail}</span>. Nothing is charged online.
                  </p>
                </>
              ) : (
                <div class="notice" role="note">
                  <p><strong>Purchase inquiries aren’t open online yet.</strong></p>
                  <p>A contact address hasn’t been added to the site. Please check back soon.</p>
                </div>
              ))
          }
          {
            data.availability === 'Reserved' && (
              <div class="notice" role="note">
                <p><strong>This piece is reserved.</strong> It’s on hold for a buyer and can’t be purchased right now.</p>
                {reservedAsk && <p><a href={reservedAsk}>Ask to hear if it becomes available</a></p>}
              </div>
            )
          }
          {
            data.availability === 'Sold' && (
              <div class="notice" role="note">
                <p><strong>This piece has been sold.</strong> It’s no longer available.</p>
                <p><a href="/artwork/">See artwork that’s available now</a></p>
              </div>
            )
          }
        </div>

        <dl class="facts">
          {data.medium && <div><dt>Medium</dt><dd>{data.medium}</dd></div>}
          {data.dimensions && <div><dt>Dimensions</dt><dd>{data.dimensions}</dd></div>}
          {data.framing && <div><dt>Framing</dt><dd>{data.framing}</dd></div>}
          <div><dt>Source</dt><dd>{sourceLabel(data.source)}</dd></div>
        </dl>

        <div class="prose description">
          <p class="lead">{data.summary}</p>
          <Content />
        </div>

        <aside class="helps" aria-labelledby="helps-heading">
          <h2 id="helps-heading">Where the money goes</h2>
          <p>
            Proceeds from this sale help pay rent for residents of sober living who can’t yet afford it.
            {" "}<a href="/our-purpose/">About this project</a>
          </p>
        </aside>
      </div>
    </article>

    {
      related.length > 0 && (
        <section class="related" aria-labelledby="related-heading">
          <div class="related__head">
            <h2 id="related-heading">More available artwork</h2>
            <a class="text-link" href={`/artwork/?category=${categoryValue(data.category)}`}>More {data.category.toLowerCase()} <ArrowIcon /></a>
          </div>
          <ul class="related__grid" role="list">
            {related.map((a) => <ArtworkCard artwork={a} />)}
          </ul>
        </section>
      )
    }

    <p class="back">
      <a class="text-link" href="/artwork/"><ArrowIcon direction="left" /> Back to all artwork</a>
    </p>
  </div>

  <ImageViewer title={data.title} images={large} />
</Base>

<style>
  .breadcrumbs {
    padding-block: 1.4rem 0;
    font-size: 0.9rem;
    color: var(--text-soft);
  }
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .breadcrumbs li + li::before {
    content: '/';
    margin-right: 0.4rem;
    color: var(--line-strong);
  }
  .breadcrumbs a {
    color: var(--text-muted);
  }
  .artwork {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    padding-top: 1.5rem;
    align-items: start;
  }
  .artwork__media {
    position: sticky;
    top: 1.5rem;
  }
  .artwork__stage {
    background: var(--surface-art);
  }
  .artwork__main {
    position: relative;
    display: block;
    cursor: zoom-in;
  }
  .artwork__main[hidden] {
    display: none;
  }
  .artwork__main :global(img) {
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
  }
  .artwork__zoom {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.7rem;
    background: rgba(250, 247, 241, 0.94);
    color: var(--text);
    font-size: 0.85rem;
    border-radius: var(--radius);
  }
  .artwork__zoom svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  .thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }
  .thumb {
    display: block;
    width: 5.25rem;
    aspect-ratio: 1;
    border: 1px solid var(--line);
    padding: 2px;
    background: var(--bg);
  }
  .thumb :global(picture) {
    display: block;
    height: 100%;
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb[aria-current='true'] {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }
  .artwork__info h1 {
    margin-top: 0.4rem;
    font-size: clamp(2.2rem, 4.4vw, 3.1rem);
  }
  .artwork__artist {
    margin-top: 0.35rem;
    font-size: 1.125rem;
    color: var(--text-muted);
  }
  .artwork__price-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .artwork__price {
    font-size: 1.6rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .artwork__price--request {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--text-muted);
  }
  .artwork__price--sold {
    color: var(--sold);
  }
  .badge {
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border: 1px solid currentColor;
    border-radius: var(--radius);
    color: var(--accent-strong);
  }
  .badge--reserved {
    color: #7a5a2c;
  }
  .badge--sold {
    color: var(--sold);
  }
  .action {
    margin-top: 1.5rem;
  }
  .action__note {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-soft);
    max-width: 30rem;
  }
  .nowrap {
    overflow-wrap: anywhere;
  }
  .notice {
    padding: 1rem 1.15rem;
    background: var(--bg-soft);
    border-left: 2px solid var(--line-strong);
    color: var(--text-muted);
    font-size: 0.975rem;
  }
  .notice p + p {
    margin-top: 0.4rem;
  }
  .notice strong {
    color: var(--text);
  }
  .notice a {
    color: var(--accent-strong);
  }
  .facts {
    margin: 2rem 0 0;
    border-top: 1px solid var(--line);
  }
  .facts div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    color: var(--text-soft);
    font-size: 0.9375rem;
  }
  .facts dd {
    margin: 0;
  }
  .description {
    margin-top: 2rem;
  }
  .description .lead {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    line-height: 1.45;
    color: var(--text);
  }
  .helps {
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--text-muted);
  }
  .helps h2 {
    font-size: 1.35rem;
    color: var(--text);
    margin-bottom: 0.5rem;
  }
  .helps a {
    color: var(--accent-strong);
  }
  .related {
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .related__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line-strong);
  }
  .related__head h2 {
    font-size: clamp(1.75rem, 3vw, 2.2rem);
  }
  .related__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem clamp(1.25rem, 3vw, 1.9rem);
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .back {
    margin-top: 3rem;
  }
  @media (max-width: 60rem) {
    .related__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 48rem) {
    .artwork {
      grid-template-columns: minmax(0, 1fr);
    }
    .artwork__media {
      position: static;
    }
  }
  @media (max-width: 30rem) {
    .related__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
