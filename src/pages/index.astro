---
import Base from '../layouts/Base.astro';
import HeroFrame from '../components/HeroFrame.astro';
import ArtworkBrowser from '../components/ArtworkBrowser.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { getFeaturedArtworks } from '../lib/artwork';
import { settings, SITE_URL } from '../lib/settings';

const featured = await getFeaturedArtworks(6);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: settings.siteName,
  url: `${SITE_URL}/`,
  description: settings.siteDescription,
};
---
<Base structuredData={structuredData}>
  <section class="hero container" aria-labelledby="hero-heading">
    <div class="hero__copy">
      <h1 id="hero-heading">{settings.heroHeading}</h1>
      {settings.heroText && <p class="hero__text">{settings.heroText}</p>}
      <a class="button" href="/artwork/">Explore the artwork <ArrowIcon /></a>
    </div>
    <div class="hero__art">
      <HeroFrame />
    </div>
  </section>

  <div class="container featured">
    <ArtworkBrowser id="featured" heading="Available artwork" artworks={featured} showCount={false} />
    <p class="featured__more">
      <a class="text-link" href="/artwork/">See all artwork <ArrowIcon /></a>
    </p>
  </div>

  <section class="mission container" aria-labelledby="mission-heading">
    <h2 id="mission-heading">{settings.missionHeading}</h2>
    <div class="mission__body">
      {settings.missionText && <p>{settings.missionText}</p>}
      <p><a class="text-link" href="/donate-art/">Donate artwork <ArrowIcon /></a></p>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-block: clamp(2rem, 3.2vw, 2.4rem) clamp(2.75rem, 5vw, 3.75rem);
  }
  .hero h1 {
    font-size: clamp(2.6rem, 5.4vw, 4.15rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    font-weight: 430;
  }
  .hero__text {
    margin-top: 1.6rem;
    max-width: 23.5rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text);
  }
  .hero .button {
    margin-top: 1.8rem;
  }
  .featured__more {
    margin-top: 2.25rem;
    text-align: right;
  }
  .mission {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 2rem 3rem;
    align-items: center;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: clamp(2.25rem, 4vw, 2.75rem);
    border-top: 1px solid var(--line-strong);
  }
  .mission h2 {
    font-size: clamp(2.1rem, 4.2vw, 3rem);
    line-height: 1.05;
  }
  .mission__body {
    padding-left: 3rem;
    border-left: 1px solid var(--line-strong);
    color: var(--text-muted);
    font-size: 1.0625rem;
  }
  .mission__body p + p {
    margin-top: 1rem;
  }
  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__copy {
      max-width: 34rem;
    }
    .mission {
      grid-template-columns: minmax(0, 1fr);
    }
    .mission__body {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
