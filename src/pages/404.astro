---
import Base from '../layouts/Base.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { getArtworks } from '../lib/artwork';

const available = (await getArtworks()).filter((a) => a.data.availability === 'Available').slice(0, 3);
---
<Base title="Page not found" description="This page couldn’t be found." noindex>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">404</p>
      <h1>This page isn’t here.</h1>
      <p>
        It may have moved, or the piece it showed may have been taken down. The artwork that’s listed now is all in the gallery.
      </p>
      <p class="links">
        <a class="button" href="/artwork/">Browse the artwork <ArrowIcon /></a>
        <a class="text-link" href="/">Go to the homepage</a>
      </p>
    </header>
    {
      available.length > 0 && (
        <section aria-labelledby="nf-heading" class="nf">
          <h2 id="nf-heading">Available now</h2>
          <ul class="grid" role="list">
            {available.map((a) => <ArtworkCard artwork={a} />)}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 1.75rem !important;
  }
  .nf {
    padding-top: 2rem;
    border-top: 1px solid var(--line-strong);
  }
  .nf h2 {
    font-size: 1.8rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem 1.75rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  @media (max-width: 60rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 30rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
